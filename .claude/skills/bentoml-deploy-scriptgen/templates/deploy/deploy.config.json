{
  "schema": "bentoml-deploy-config/v2",
  "project": {
    "dir": "..",
    "service": null,
    "name": "{{SERVICE_NAME}}"
  },
  "image": {
    "registry": "{{IMAGE_REGISTRY}}",
    "repository": "{{IMAGE_REPOSITORY}}",
    "registry_type": "{{REGISTRY_TYPE}}",
    "platform": null,
    "estimated_size_gb": 2.0,
    "local_image_preloaded": false
  },
  "verify": {
    "readyz_timeout_seconds": 600,
    "inference": {
      "path": "{{INFERENCE_PATH}}",
      "body": {{INFERENCE_BODY}},
      "expect_substring": "{{EXPECT_SUBSTRING}}",
      "timeout_seconds": 60
    },
    "dependency_metrics": true
  },
  "targets": {
    "ec2": {
      "hosts": ["{{EC2_HOST}}"],
      "ssh_user": "{{EC2_SSH_USER}}",
      "ssh_key_path": "{{EC2_SSH_KEY_PATH}}",
      "container_name": "{{SERVICE_NAME}}",
      "host_port": 3000,
      "env_names": [],
      "registry_auth": "{{EC2_REGISTRY_AUTH}}",
      "verify_via": "tunnel",
      "local_tunnel_port": 3230
    },
    "k8s": {
      "context": "{{K8S_CONTEXT}}",
      "namespace": "{{NAMESPACE}}",
      "//services": "One object per BentoML service, in rollout order: dependencies first, entry last. Exactly one has \"entry\": true (the externally exposed service verify targets). Each slug names deployment/<slug>, svc/<slug>, and the <slug>-deployment.yaml / <slug>-service.yaml manifests. A single-service bento has a ONE-element list with \"entry\": true.",
      "services": [
        {
          "name": "{{DEP_SERVICE_NAME}}",
          "slug": "{{DEP_SERVICE_SLUG}}",
          "entry": false
        },
        {
          "name": "{{ENTRY_SERVICE_NAME}}",
          "slug": "{{ENTRY_SERVICE_SLUG}}",
          "entry": true
        }
      ],
      "manifests_dir": "k8s",
      "image_pull_secret": null,
      "rollout_timeout_seconds": 900,
      "local_port": 3130,
      "node_port": null
    }
  }
}
